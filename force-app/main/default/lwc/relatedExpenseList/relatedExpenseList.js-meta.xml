<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Related Expenses</masterLabel>
    <description>Displays related Expense records for Contacts, Accounts, and Visits.</description>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Contact</object>
                <object>Account</object>
                <object>Visit</object>
            </objects>
            <supportedFormFactors>
                <supportedFormFactor type="Large" /> <!-- Desktop -->
                <supportedFormFactor type="Small" /> <!-- Phone -->
            </supportedFormFactors>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>